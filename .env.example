# Скопируйте файл в .env и заполните значения.
# .env в репозиторий не попадает (см. .gitignore).

# --- база данных (сервис db в compose.yaml) ---
# Пользователь и база создаются контейнером postgres при первом старте.
POSTGRES_USER=nids
POSTGRES_PASSWORD=
POSTGRES_DB=nids

# Строка подключения к PostgreSQL (журнал предсказаний).
# Для стека compose хост — имя сервиса db, а не localhost:
# postgresql://nids:<пароль>@db:5432/nids
DATABASE_URL=

# --- сервис api ---
# Каталог, где лежит model.pkl (по умолчанию artifacts)
MODEL_DIR=

# Версия модели, которая пишется в журнал предсказаний
MODEL_VERSION=
