# Скопируйте файл в .env и заполните значения.
# .env в репозиторий не попадает (см. .gitignore).

# Строка подключения к PostgreSQL (журнал предсказаний)
DATABASE_URL=

# Каталог, где лежит model.pkl (по умолчанию artifacts)
MODEL_DIR=

# Версия модели, которая пишется в журнал предсказаний
MODEL_VERSION=
