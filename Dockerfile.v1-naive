FROM python:3.12-slim

WORKDIR /app

# Наивный порядок: сначала копируется весь код, потом ставятся зависимости.
COPY . .

RUN pip install --no-cache-dir -e .

# Модель обучается при сборке: контейнер самодостаточен.
RUN python data/make_dataset.py && python -m nids.train

EXPOSE 8000

CMD ["uvicorn", "nids.api:app", "--host", "0.0.0.0", "--port", "8000"]
